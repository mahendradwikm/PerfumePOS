# ---------------------------------------------------------------------------
# Environment for the Docker Compose stack.
#
#   cp .env.docker.example .env.docker
#   # edit every value marked CHANGE ME
#   docker compose --env-file .env.docker up -d --build
#
# This file holds real credentials, so it must never be committed.
# It is already excluded from the build context by .dockerignore.
# ---------------------------------------------------------------------------

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=perfume_pos
POSTGRES_USER=postgres
# CHANGE ME — generate with:  openssl rand -hex 32
#
# IMPORTANT: this value is interpolated into DATABASE_URL by compose, so it must
# be URL-safe. Use `-hex`, NOT `-base64`: base64 can emit / : + ? # which break
# the connection string. Not allowed: @ : / ? # [ ] %
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ---- NextAuth --------------------------------------------------------------
# CHANGE ME — generate with:  openssl rand -hex 32
#
# NEXTAUTH_URL MUST equal the URL users actually type in, scheme + host + port.
# It is not cosmetic: NextAuth uses it to build the post-login redirect. If it
# says "localhost" while you are browsing on 192.168.x.x, a successful login
# bounces you to http://localhost:3000/pos — which resolves to the *other*
# device's own localhost and appears to fail.
#
# Leaving it blank does NOT auto-detect the address; NextAuth falls back to
# http://localhost:3000, so the same breakage happens.
#
#   host machine only : http://localhost:3000
#   LAN / Wi-Fi       : http://192.168.100.121:3000   <- find yours with
#                       ipconfig  (IPv4 Address of the Wi-Fi adapter)
#
# Re-check this after a DHCP lease change or a Wi-Fi reconnect, otherwise logins
# from phones/tablets will land on the wrong host.
NEXTAUTH_SECRET=CHANGE_ME_random_jwt_secret
NEXTAUTH_URL=http://localhost:3000

# ---- Published port --------------------------------------------------------
# Left-hand side is the host port; the container always listens on 3000.
#
# BIND_ADDRESS=0.0.0.0 publishes to every interface so other devices on the same
# LAN/Wi-Fi can reach the app. Keep it when developing on a trusted network.
# Set BIND_ADDRESS=127.0.0.1 to lock the app to this machine only — required when
# nginx/Caddy is the intended entry point, and the safer choice on untrusted or
# public Wi-Fi. The database is never published either way.
BIND_ADDRESS=0.0.0.0
APP_PORT=3000

# ---- App metadata / timezone ----------------------------------------------
NEXT_PUBLIC_APP_NAME=Parfume POS
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta